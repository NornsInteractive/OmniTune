<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Cover Art + Song Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Artwork -->
        <ImageView
            android:id="@+id/widget_large_artwork"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/widget_cover_rounded"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_music_note" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Format Badge -->
            <TextView
                android:id="@+id/widget_large_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_background"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="FLAC · 96kHz / 24bit"
                android:textColor="#58A6FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Track Title -->
            <TextView
                android:id="@+id/widget_large_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="告白气球"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Artist -->
            <TextView
                android:id="@+id/widget_large_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="周杰伦"
                android:textColor="#E6EDF3"
                android:textSize="13sp" />

            <!-- Album -->
            <TextView
                android:id="@+id/widget_large_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="周杰伦的床边故事"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar & Timestamps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/widget_large_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="350"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_large_time_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:18"
                android:textColor="#8B949E"
                android:textSize="10sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_large_time_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:35"
                android:textColor="#8B949E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_large_favorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_widget_favorite_inactive" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_large_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_widget_skip_prev" />

        <ImageView
            android:id="@+id/widget_large_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/widget_button_circle"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_widget_play_dark" />

        <ImageView
            android:id="@+id/widget_large_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_widget_skip_next" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_large_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:src="@mipmap/ic_launcher" />
    </LinearLayout>

    <!-- Divider Line (Whitelisted RemoteView FrameLayout) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#202636" />

    <!-- Lyric Snippet Banner -->
    <LinearLayout
        android:id="@+id/widget_large_lyric_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪ "
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_large_current_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="亲爱的 爱上你 从那天起 甜蜜的很轻易"
            android:textColor="#E6EDF3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Queue Next Up Preview -->
    <LinearLayout
        android:id="@+id/widget_large_queue_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_large_queue_next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Next: 晴天 · 周杰伦"
            android:textColor="#6E7681"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_large_queue_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Then: 七里香 · 周杰伦"
            android:textColor="#484F58"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
