{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnitune-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-20",
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
